# Copy to .env.local (local) or add each line in Replit → Secrets. Never commit real keys.

PROJECT_NAME="StockNow"
# Google Gemini: writes the plan summary and supplier messages. Leave empty to use the built-in templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# If that model is overloaded or slow, StockNow tries these next (comma-separated, optional):
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Supabase: permanent storage. Leave both empty to run on the built-in demo store (resets on restart).
# Use the service_role key (Supabase → Project Settings → API). It stays on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Orbyte Payment: shared secret for signed payment events (POST /api/orbyte/payment). Leave empty to turn it off.
# The demo button on Stock Out works without it.
ORBYTE_WEBHOOK_SECRET=