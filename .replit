# Replit runs `npm run dev` for the editor preview and builds + starts the app for Deployments.
modules = ["nodejs-22"]
run = "npm install && npm run dev"
entrypoint = "src/app/page.js"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "npm run start"]

[[ports]]
localPort = 3000
externalPort = 80